# Copie para poc/.env e preencha. O .env nunca vai para o git.

# Supabase > Connect > Session pooler (IPv4). A conexão direta do plano grátis é só IPv6.
# Formato: postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# E-mail de contato exigido pela política de uso do Nominatim (vai no User-Agent).
NOMINATIM_EMAIL=

# Caminhos do OAuth do Google (relativos a poc/).
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Limites da PoC (escopo §3.6).
MAX_DOWNLOAD_MB=50
MAX_TEXT_KB=200
DB_SIZE_STOP_MB=400
